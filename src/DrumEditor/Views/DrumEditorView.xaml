<UserControl x:Class="DrumEditor.Views.DrumEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:DrumEditor.Controls" Background="#101216" Foreground="#CDD2DA" FontFamily="Segoe UI" PreviewKeyDown="Keys" SizeChanged="LayoutChanged">
 <UserControl.Resources>
<ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DrumEditor;component/Controls/ScrollStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="Accent" Color="#3CD3A3"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#202329"/><Setter Property="Foreground" Value="#CED1D7"/><Setter Property="BorderBrush" Value="#2C3036"/><Setter Property="Padding" Value="16,5"/><Setter Property="Margin" Value="3"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#191C21"/><Setter Property="Foreground" Value="#3CD3A3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#202329"/><Setter Property="Foreground" Value="#CDD1D8"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#8A929E"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <Border Background="#15181D" Padding="8,3"><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/></Border>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="4" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
   <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="#202329" BorderBrush="#3A4049" BorderThickness="1"><ItemsPresenter/></Border></Popup>
  </Grid></ControlTemplate></Setter.Value></Setter></Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="RootLayout" Background="#101216">
  <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#171A1F" BorderBrush="#2A2F37" BorderThickness="0,0,1,0"><StackPanel x:Name="Navigation" Margin="0,20,0,0"/></Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="118"/><RowDefinition Height="94"/><RowDefinition Height="*"/><RowDefinition Height="38"/><RowDefinition Height="34"/></Grid.RowDefinitions>
   <Grid Margin="12,16,12,16">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="204"/></Grid.ColumnDefinitions>
    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="TapButton" Content="Tap" Width="68" Click="Tap"/>
      <Border Background="#191D23" BorderBrush="#2A2F37" BorderThickness="1" Margin="3"><Grid Width="90"><TextBox x:Name="BpmBox" Text="40" FontSize="28" FontWeight="Bold" Padding="0,0,0,14" LostFocus="CommitBpm" KeyDown="BpmKey" ToolTip="BPM 1～300"/><TextBlock Text="BPM" FontSize="12" Foreground="#7D8692" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" IsHitTestVisible="False"/></Grid></Border>
      <Button x:Name="MinusBpm" Content="−" Width="49" Click="BpmMinus"/><Button x:Name="PlusBpm" Content="＋" Width="49" Click="BpmPlus"/>
      <StackPanel x:Name="Meters" Orientation="Horizontal" Margin="6,0"/>
      <Button x:Name="Metro" Click="Metronome" Width="230" HorizontalContentAlignment="Stretch" Padding="12,0"><StackPanel Orientation="Horizontal"><TextBlock Text="メトロノーム" x:Name="MetroText" FontSize="17" VerticalAlignment="Center"/><StackPanel x:Name="BeatLights" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Button>
      <Button x:Name="PlayButton" Width="68" Click="Play"><Path Data="M 0,0 L 0,23 L 18,11.5 Z" Fill="#CDD2DA" Stretch="Uniform" Width="18" Height="23"/></Button>
      <Button Width="68" Click="Stop"><Rectangle Width="16" Height="16" Fill="#CDD2DA"/></Button>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="小節" VerticalAlignment="Center" Foreground="#7D8692" Margin="0,0,10,0"/><Button x:Name="MinusBars" Content="−" Width="44" Click="BarsMinus"/><Border Background="{StaticResource Accent}" Margin="3" Width="56"><TextBlock x:Name="BarsText" FontSize="23" FontWeight="Bold" Foreground="#09251C" TextAlignment="Center" VerticalAlignment="Center"/></Border><Button x:Name="PlusBars" Content="＋" Width="44" Click="BarsPlus"/></StackPanel>
   </Grid>
   <ScrollViewer x:Name="CardScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" SizeChanged="LayoutChanged"><UniformGrid x:Name="Tracks" Columns="13" Height="102" VerticalAlignment="Top" HorizontalAlignment="Left"/></ScrollViewer>
   <Grid Grid.Row="2" Margin="12,9"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="34"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><TextBlock Text="全体音量" VerticalAlignment="Center" Margin="20,0,10,0"/><Slider x:Name="OutputVolume" Minimum="0" Maximum="100" Value="50" Width="130" VerticalAlignment="Center" ValueChanged="VolumeChanged" ToolTip="全体の再生音量。音割れが気になる場合は下げてください。"/><TextBlock x:Name="VolumeText" Text="50%" Width="44" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock Text="ファイル" VerticalAlignment="Center" Margin="0,0,6,0"/><Button x:Name="MidiImportButton" Content="読み込み" Width="90" Padding="8,5" Click="MidiImportClick" ToolTip="フォルダー内のMIDIを一覧から読み込み"/><Button x:Name="ExportButton" Content="書き出し" Width="90" Padding="8,5" Click="ExportClick" ToolTip="MIDIまたはWAVを選んで書き出し"/><Button Content="Clear" Width="86" Click="Clear"/><Button Content="Random" Width="114" Click="Randomize"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal"><Button x:Name="CopyBarsButton" Content="小節コピー" Width="100" Padding="8,3" Click="CopyBarsClick"/><Button x:Name="PasteBarsButton" Content="貼り付け" Width="88" Padding="8,3" Click="PasteBarsClick"/><Button x:Name="DuplicateBarsButton" Content="複製" Width="70" Padding="8,3" Click="DuplicateBarsClick"/><Button x:Name="RangeLoopButton" Content="範囲ループ" Width="110" Padding="8,3" Click="RangeLoopClick"/><TextBlock x:Name="RangeText" Text="拍見出しで小節を選択" VerticalAlignment="Center" Margin="12,0" FontSize="12"/></StackPanel></Grid>
   <Grid Grid.Row="3" x:Name="RollArea">
    <Grid.ColumnDefinitions><ColumnDefinition Width="222"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="8"/><RowDefinition Height="174" MinHeight="80"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="RulerScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ><c:DrumGrid x:Name="BeatRuler" HorizontalAlignment="Left" Part="Ruler" VerticalAlignment="Top"/></ScrollViewer>
    <ScrollViewer x:Name="LabelScroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" ScrollChanged="LabelScrollChanged"><StackPanel x:Name="Labels"/></ScrollViewer>
    <ScrollViewer x:Name="Scroller" Grid.Column="1" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="RollScrollChanged" SizeChanged="LayoutChanged"><c:DrumGrid x:Name="DrumGrid" HorizontalAlignment="Left" Focusable="True" Part="Notes" VerticalAlignment="Top"/></ScrollViewer>
    <GridSplitter x:Name="EditorSplitter" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#363D46" Cursor="SizeNS" ShowsPreview="False" ToolTip="上下にドラッグして音符と音量の高さを変更"/>
    <Grid Grid.Row="3"><TextBlock Text="音符の強さ" Margin="12,8" FontSize="12"/><TextBlock Text="127" HorizontalAlignment="Right" Margin="0,7,12,0" FontSize="13" Foreground="#7D8692"/><TextBlock Text="64" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13" Foreground="#7D8692"/><TextBlock Text="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10" FontSize="13" Foreground="#7D8692"/></Grid>
    <ScrollViewer x:Name="VelocityScroller" SizeChanged="LayoutChanged" Grid.Column="1" Grid.Row="3" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><c:DrumGrid x:Name="VelocityGrid" HorizontalAlignment="Left" Focusable="True" Part="Velocity" VerticalAlignment="Top"/></ScrollViewer>
    <ComboBox x:Name="Division" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="74" Margin="0,0,12,10" SelectionChanged="DivisionChanged" ToolTip="配置の刻み"><ComboBoxItem Content="1/4"/><ComboBoxItem Content="1/8"/><ComboBoxItem Content="1/16"/></ComboBox>
   </Grid>
   <Border Grid.Row="4" Background="#13171C"><TextBlock x:Name="Status" Margin="14,8" Foreground="#7D8692" FontSize="13"/></Border>
   <TextBlock Grid.Row="5" x:Name="Hint" Margin="14,7" Foreground="#7D8692" FontSize="13" Text="クリックで配置 · ドラッグで移動 · Deleteで削除 · 右クリックで保存／MIDI"/>
  </Grid>
 </Grid>
</UserControl>
