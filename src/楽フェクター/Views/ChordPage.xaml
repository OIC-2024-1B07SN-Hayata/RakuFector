<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:ChordDetection.App.ViewModels" xmlns:views="clr-namespace:ChordDetection.App.Views" x:Class="FXForge.Views.ChordPage" Background="{DynamicResource WindowBackground}" FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" Foreground="{DynamicResource TextPrimary}" AllowDrop="True" DragOver="OnAudioDragOver" Drop="OnAudioDrop">
  <UserControl.Resources><ResourceDictionary>
            <!-- Index 0 is the theme; MainWindow replaces it when ダークモード is switched. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ChordDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="UiFont">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <views:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility"/>

            <!-- Rounded card (マイク入力 / timeline). -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <Style x:Key="Icon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Flat button: dark fill with a thin border (クリア). -->
            <Style x:Key="FlatButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Height" Value="64"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 録音開始 / 停止して解析. -->
            <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Background" Value="{DynamicResource RecordBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource RecordBackground}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RecordHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Capo suggestion row: left-aligned content; the capo selected now is outlined. -->
            <Style x:Key="SuggestionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Playhead}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tabs at the top of the left card: equal-width headers with an underline on the selected one. -->
            <Style x:Key="CardTabs" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Margin="12,8,12,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                                    <UniformGrid Rows="1" IsItemsHost="True"/>
                                </Border>
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardTab" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="4,14,4,11">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Playhead}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small button in the developer section. -->
            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- 指板 open / close button in the timeline header; highlighted while the panel is open. -->
            <Style x:Key="PanelToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Playhead}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segmented tabs of the fretboard panel (コードフォーム / スケール). -->
            <Style x:Key="SegmentTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="96"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="14,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FretScaleNote}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar item: icon above the label; the checked one is highlighted. -->
            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource SidebarText}"/>
                <Setter Property="Height" Value="108"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarActiveBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- On/off switch (ダークモード). -->
            <Style x:Key="Switch" TargetType="ToggleButton">
                <Setter Property="Width" Value="68"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Track" CornerRadius="19" Background="{DynamicResource MeterOff}">
                                <Ellipse x:Name="Knob" Width="30" Height="30" Fill="White" Margin="4,0" HorizontalAlignment="Left"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource SwitchOn}"/>
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBox that follows the theme (the default template ignores Background on Windows 10/11). -->
            <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
                <Border Background="Transparent">
                    <TextBlock Text="" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimary}"/>
                </Border>
            </ControlTemplate>

            <Style x:Key="ThemedComboBox" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Height" Value="58"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/>
                                <ContentPresenter Margin="20,0,40,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="300">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd" Padding="16,8" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Smaller ComboBox for the developer section. -->
            <Style x:Key="SmallComboBox" TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- Option in 設定 (歪み / 音源分離). -->
            <Style x:Key="SettingCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DevCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
  <DockPanel><TextBlock x:Name="InitErrorText" DockPanel.Dock="Top" Visibility="Collapsed" Background="#52251F" Foreground="#FFD5B7" Padding="16" Margin="20,12,20,0" TextWrapping="Wrap"/><Grid Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- マイク入力 / 移調・カポ / 設定: switched by the tabs at the top -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <TabControl Style="{StaticResource CardTabs}">
                        <TabItem Style="{StaticResource CardTab}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="マイク入力"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="24,4,24,28">
                                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                        <Ellipse Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{Binding StateColor}"/>
                                        <TextBlock Text="{Binding StateLabel}" FontSize="18" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>

                                    <views:LevelMeter Height="20" Margin="0,16,0,0" Level="{Binding InputLevel}" Segments="22" OffBrush="{DynamicResource MeterOff}" OnBrush="{DynamicResource MeterOn}" ToolTip="入力レベル"/>

                                    <!-- ギター直結: FX Forge の共通音声入力（ASIO） -->
                                    <CheckBox Style="{StaticResource SettingCheckBox}" Margin="0,18,0,0" Content="ASIO で録音（ギター直結）" IsChecked="{Binding UseAsio}" IsEnabled="{Binding IsIdle}" ToolTip="オーディオインターフェースの ASIO ドライバーから、ギターをつないだ入力を録音します"/>
                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding UseAsio, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="ASIO入力はアプリ右上の ⚙ で設定（他の機能と共有）" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,8"/><TextBlock Text="{Binding InputGainText}" FontSize="13" Margin="0,4,0,2" Foreground="{DynamicResource TextMuted}"/>
                                        <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding InputGainDb}" ToolTip="ギターの音が小さいときに上げます（録音中も変更可）"/>
                                    </StackPanel>

                                    <!-- 小節に合わせる: records to the drum editor's pattern and shows a chord sheet bar by bar -->
                                    <CheckBox Style="{StaticResource SettingCheckBox}" Margin="0,18,0,0" Content="録音中にドラムを鳴らす" IsChecked="{Binding PlayDrumsWhileRecording}" IsEnabled="{Binding IsIdle}" Visibility="{Binding IsTempoAvailable, Converter={StaticResource BoolToVisibility}}" ToolTip="録音開始と同時にドラム編集のパターン（ドラム・メトロノーム）を先頭から鳴らし、録音を止めると止めます"/>
                                    <CheckBox Style="{StaticResource SettingCheckBox}" Margin="0,10,0,0" Content="小節に合わせる（コード譜を作る）" IsChecked="{Binding SyncToBars}" IsEnabled="{Binding IsIdle}" Visibility="{Binding IsTempoAvailable, Converter={StaticResource BoolToVisibility}}" ToolTip="録音中に鳴らすドラムの BPM・拍子で、小節ごとのコード譜を作ります（ドラムも鳴らします）"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Visibility="{Binding PlayDrumsWhileRecording, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="{Binding TempoText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/><Run Text="  ドラム編集の BPM・拍子で鳴らします"/>
                                    </TextBlock>
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasGridLines, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="タイムラインの細かい線" FontSize="13" Margin="0,0,0,4" Foreground="{DynamicResource TextMuted}"/>
                                        <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding LineDivisions}" SelectedItem="{Binding SelectedLineDivision}" DisplayMemberPath="Label" ToolTip="拍の間に引く薄い縦線の細かさ（録音後も変更できます）"/>
                                    </StackPanel>
                                    <!-- Drum / metronome levels (shared with the drum editor; can be changed while recording) -->
                                    <StackPanel Margin="0,4,0,0" Visibility="{Binding PlayDrumsWhileRecording, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="13" Margin="0,4,0,2" Foreground="{DynamicResource TextMuted}"><Run Text="ドラム音量  "/><Run Text="{Binding DrumVolumeText, Mode=OneWay}"/></TextBlock>
                                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DrumVolumePercent}" ToolTip="録音中に鳴らすドラムの音量（録音中も変更可・ドラム編集の再生にも反映）"/>
                                        <CheckBox Style="{StaticResource SettingCheckBox}" Margin="0,10,0,0" Content="メトロノームを鳴らす" IsChecked="{Binding MetronomeEnabled}" ToolTip="1 拍ごとにクリックを鳴らします（ドラム編集のメトロノームボタンと同じ設定）"/>
                                        <TextBlock FontSize="13" Margin="0,6,0,2" Foreground="{DynamicResource TextMuted}"><Run Text="メトロノーム音量  "/><Run Text="{Binding MetronomeVolumeText, Mode=OneWay}"/></TextBlock>
                                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MetronomeVolumePercent}" IsEnabled="{Binding MetronomeEnabled}" ToolTip="メトロノームのクリックの音量（録音中も変更可・ドラム編集の再生にも反映）"/>
                                    </StackPanel>

                                    <Button Margin="0,22,0,0" Style="{StaticResource RecordButton}" Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}"/>
                                    <Button Margin="0,12,0,0" Style="{StaticResource FlatButton}" Command="{Binding OpenAudioFileCommand}" ToolTip="WAV / MP3 / M4A / AAC / WMA / FLAC を開いて解析します（タイムラインへのドラッグ＆ドロップでも開けます）">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0"/>
                                            <TextBlock Text="音声ファイルを開く…"/>
                                        </StackPanel>
                                    </Button>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="96"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource FlatButton}" Content="{Binding PlayButtonText}" Command="{Binding TogglePlaybackCommand}" ToolTip="解析した音を再生します（音源分離したときも元の音）。タイムラインのコードをクリックすると、そこから再生します"/>
                                        <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="■  停止" Command="{Binding StopPlaybackCommand}" ToolTip="停止して先頭に戻ります"/>
                                    </Grid>
                                    <TextBlock Text="{Binding PlaybackTimeText}" FontSize="15" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="96"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource SettingCheckBox}" VerticalAlignment="Center" Content="区間ループ" IsChecked="{Binding IsLoopEnabled}" IsEnabled="{Binding HasLoop}" ToolTip="タイムライン上部の目盛りをドラッグした区間を繰り返し再生します（小節線があるときは、タイムラインに表示されている線に合わせます）"/>
                                        <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="解除" Command="{Binding ClearLoopCommand}" ToolTip="ループ区間を消します"/>
                                    </Grid>
                                    <TextBlock Text="{Binding LoopText}" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                    <Button Margin="0,12,0,0" Style="{StaticResource FlatButton}" Content="クリア" Command="{Binding ClearCommand}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Style="{StaticResource CardTab}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="移調・カポ"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="24,0,24,28">
                                    <!-- Transposition / capo (display only, no re-analysis) -->
                                    <!-- Transposition follows the capo (capo 2 → +2); shown only. -->
                                    <DockPanel Margin="0,20,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TransposeText}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" ToolTip="カポを選ぶと、カポの数だけ移調します"/>
                                        <TextBlock Text="移調（半音）" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                    </DockPanel>

                                    <TextBlock Text="カポ（フレット）" FontSize="18" Margin="0,20,0,12" Foreground="{DynamicResource TextPrimary}"/>
                                    <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding CapoOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Capo}" ToolTip="カポを付けると、タイムラインに「押さえる形」も表示します"/>

                                    <!-- Degrees of the estimated key (Ⅰ, Ⅵm …) below the chord names -->
                                    <CheckBox Style="{StaticResource SettingCheckBox}" Margin="0,20,0,0" Content="ディグリーを表示（コード名の下）" IsChecked="{Binding ShowDegrees}" ToolTip="推定したキー（移調後）を基準に、タイムラインとコード譜のコード名の下にディグリーを表示します"/>
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowDegrees, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="マイナーキーの基準" FontSize="13" Margin="0,0,0,4" Foreground="{DynamicResource TextMuted}"/>
                                        <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding MinorDegreeBases}" SelectedItem="{Binding SelectedMinorDegreeBase}" DisplayMemberPath="Label" ToolTip="マイナーキーの曲で、どの音を Ⅰ にするか（メジャーキーの曲では表示は変わりません）"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Text="{Binding DegreeHint}"/>
                                    </StackPanel>

                                    <!-- Timeline scale: seconds shown without scrolling -->
                                    <TextBlock Text="タイムラインの幅" FontSize="18" Margin="0,20,0,12" Foreground="{DynamicResource TextPrimary}"/>
                                    <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding TimelineZooms}" SelectedItem="{Binding SelectedTimelineZoom}" DisplayMemberPath="Label" ToolTip="スクロールせずに見える秒数（ウィンドウ幅 1600 のとき）。短くするとコード名が読みやすく、長くすると全体を見渡せます"/>

                                    <DockPanel Margin="0,22,0,6">
                                        <TextBlock Text="カポ位置の提案" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding CapoSuggestionSourceText}" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                    <ItemsControl ItemsSource="{Binding CapoSuggestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CapoSuggestionRow}">
                                                <Button Style="{StaticResource SuggestionButton}" ToolTip="クリックでこのカポ位置にします"
                                                        CommandParameter="{Binding}" Command="{Binding DataContext.ApplyCapoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreText}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Shapes}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Style="{StaticResource CardTab}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="設定"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="24,0,24,28">
                                    <TextBlock Text="チューニング" FontSize="18" Margin="0,20,0,12" Foreground="{DynamicResource TextPrimary}"/>
                                    <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding Tunings}" SelectedItem="{Binding SelectedTuning}" IsEnabled="{Binding IsIdle}" ToolTip="基準ピッチ（現在は表示のみ。解析は 440Hz 固定です）"/>

                                    <CheckBox Style="{StaticResource SettingCheckBox}" Margin="0,20,0,0" Content="音作りした音（歪み）" IsChecked="{Binding IsToneShaped}" IsEnabled="{Binding IsIdle}" ToolTip="歪ませた音向け。歪みで弱くなった弾いた音も拾うように、音の検出の条件を緩めます（次の解析から有効）"/>
                                    <CheckBox Style="{StaticResource SettingCheckBox}" Margin="0,14,0,0" Content="音源分離（Demucs）して解析" IsChecked="{Binding UseSourceSeparation}" IsEnabled="{Binding IsSeparationAvailable}" ToolTip="{Binding SeparationToolTip}" ToolTipService.ShowOnDisabled="True"/>
                                    <ComboBox Style="{StaticResource ThemedComboBox}" Height="44" FontSize="16" Margin="30,10,0,0" ItemsSource="{Binding Stems}" SelectedItem="{Binding SelectedStem}" DisplayMemberPath="Label" IsEnabled="{Binding UseSourceSeparation}" ToolTip="音源分離のあとに解析するトラック（ファイルを開いたときに有効）"/>

                                    <!-- Demo / evaluation features that are not part of the product screen. -->
                                    <Expander Margin="0,24,0,0" FontSize="14">
                                        <Expander.Header>
                                            <TextBlock Text="詳細設定（開発用）" Foreground="{DynamicResource TextSecondary}"/>
                                        </Expander.Header>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="入力デバイス" FontSize="13" Margin="0,0,0,4" Foreground="{DynamicResource TextMuted}"/>
                                            <ComboBox Style="{StaticResource SmallComboBox}" ItemsSource="{Binding InputDevices}" SelectedIndex="{Binding SelectedDeviceIndex}" IsEnabled="{Binding IsIdle}" ToolTip="録音する入力デバイス（ギターをつないだオーディオインターフェース）"/>
                                            <CheckBox Style="{StaticResource DevCheckBox}" Margin="0,6,0,6" Content="クロマ方式で解析（比較用）" IsChecked="{Binding UseChroma}" IsEnabled="{Binding IsIdle}" ToolTip="Basic Pitch を使わず、12音の強さ（クロマ）からコードを判定します。今の方式と結果を比べるために使います（次の解析から有効。「音作りした音」の設定は効きません）"/>
                                            <Button Style="{StaticResource SmallButton}" Content="音のリストをCSV保存…" Command="{Binding ExportNotesCommand}" ToolTip="公式Python版との比較用（tools/compare_notes.py）"/>
                                            <Button Style="{StaticResource SmallButton}" Content="解析をキャンセル" Command="{Binding CancelAnalysisCommand}" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- Timeline on top, chord sheet in the remaining space, fretboard panel fixed at the bottom
                     (it grows upwards and the chord sheet gives way) -->
                <Grid Grid.Column="2" x:Name="RightColumn" SizeChanged="OnFretboardSpaceChanged">
                <Grid.RowDefinitions>
                    <!-- Timeline and chord sheet share the space above the panel (the timeline gets more) and shrink as it grows -->
                    <RowDefinition Height="2*"/>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="*"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBars}" Value="False">
                                        <Setter Property="Height" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Timeline -->
                <Border x:Name="TimelineCard" Grid.Row="0" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <!-- Closed while the fretboard panel is enlarged over it -->
                                <DataTrigger Binding="{Binding IsTimelineHidden}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <!-- Header: title and the key of the whole performance (shown once the analysis has finished). -->
                        <Grid DockPanel.Dock="Top" Height="48" Margin="20,12,20,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="コード進行" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource PanelToggle}" Margin="0,0,12,0" IsChecked="{Binding IsFretboardOpen}"
                                          ToolTip="指板（コードフォーム / スケール）を開く・閉じる。開いている間はコード進行を小さく表示します">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A1;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,8,0"/>
                                    <TextBlock Text="指板" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" Margin="8,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Text" Value="&#xE70D;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFretboardOpen}" Value="True">
                                                        <Setter Property="Text" Value="&#xE70E;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ToggleButton>
                            <Border VerticalAlignment="Center" Height="44" CornerRadius="6" ClipToBounds="True"
                                    Background="{DynamicResource KeyBadgeBackground}" BorderBrush="{DynamicResource KeyBadgeBorder}" BorderThickness="1"
                                    Visibility="{Binding IsKeyVisible, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Left" Width="4" Fill="{DynamicResource Playhead}"/>
                                    <StackPanel Orientation="Horizontal" Margin="14,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="KEY" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource KeyBadgeLabel}" VerticalAlignment="Center" Margin="0,2,10,0"/>
                                        <TextBlock Text="{Binding KeyName}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding KeyDetail}" FontSize="13" Foreground="{DynamicResource KeyBadgeLabel}" VerticalAlignment="Center" Margin="14,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Status / result (the blank area under the scroll bar in the design). -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,14">
                            <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding AnalysisProgress, Mode=OneWay}" Foreground="{DynamicResource Playhead}" Background="{DynamicResource MeterOff}" BorderThickness="0" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}"/>
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding SourceName, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding SummaryText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <Grid>
                        <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnTimelineMouseWheel" PreviewMouseLeftButtonDown="OnTimelinePanDown"
                                      PreviewMouseMove="OnTimelinePanMove" PreviewMouseLeftButtonUp="OnTimelinePanUp" LostMouseCapture="OnTimelinePanLostCapture">
                            <!-- As tall as the card leaves (no fixed height): grows and shrinks with the space above the fretboard panel -->
                            <Grid x:Name="TimelineGrid" Width="{Binding TimelineWidth}" HorizontalAlignment="Left" SizeChanged="OnTimelineGridSizeChanged">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44"/>
                                    <RowDefinition Height="2*"/>
                                    <!-- Detected notes: hidden while the timeline is low (compact) -->
                                    <RowDefinition>
                                        <RowDefinition.Style>
                                            <Style TargetType="RowDefinition">
                                                <Setter Property="Height" Value="*"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTimelineCompact}" Value="True">
                                                        <Setter Property="Height" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RowDefinition.Style>
                                    </RowDefinition>
                                </Grid.RowDefinitions>

                                <!-- Ruler: mm:ss every second -->
                                <ItemsControl Grid.Row="0" ItemsSource="{Binding Ticks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineTick}">
                                            <!-- With bar lines the ruler shows bar / beat numbers on top and the seconds smaller below them. -->
                                            <Canvas>
                                                <TextBlock Canvas.Left="6" Text="{Binding Label}" Foreground="{DynamicResource TextMuted}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Canvas.Top" Value="12"/>
                                                            <Setter Property="FontSize" Value="15"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.HasGridLines, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                    <Setter Property="Canvas.Top" Value="33"/>
                                                                    <Setter Property="FontSize" Value="11"/>
                                                                    <Setter Property="Opacity" Value="0.8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Rectangle Canvas.Top="40" Width="1.5" Height="12" Fill="{DynamicResource TextMuted}">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.HasGridLines, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource CardBorder}"/>

                                <!-- Bar / beat / grid lines (小節に合わせる), styled after the drum editor: bars strongest, beats lighter,
                                     the thin grid lines start as ticks at the bottom of the ruler. Drawn before the chords so they stay behind them. Bar 1 is the first bar of the drums. -->
                                <!-- The lines are drawn long and cut at the timeline's height (a Canvas does not ask for their size) -->
                                <Canvas Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False">
                                    <Path Data="{Binding SubdivisionLines}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1" Opacity="0.28"/>
                                    <Path Data="{Binding BeatLines}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5" Opacity="0.6"/>
                                    <Path Data="{Binding BarLines}" Stroke="{DynamicResource TextSecondary}" StrokeThickness="2.5" Opacity="0.9"/>
                                </Canvas>

                                <!-- Loop range (dragged on the ruler): a light band over the lanes, stronger in the ruler; faded while the loop is off -->
                                <Canvas Grid.RowSpan="3" IsHitTestVisible="False" Visibility="{Binding HasLoop, Converter={StaticResource BoolToVisibility}}">
                                    <Canvas.Style>
                                        <Style TargetType="Canvas">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoopEnabled}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Canvas.Style>
                                    <Rectangle Canvas.Left="{Binding LoopLeft}" Width="{Binding LoopWidth}" Height="{Binding ActualHeight, ElementName=TimelineGrid}" Fill="{DynamicResource Playhead}" Opacity="0.12"/>
                                    <Rectangle Canvas.Left="{Binding LoopLeft}" Width="{Binding LoopWidth}" Height="52" Fill="{DynamicResource Playhead}" Opacity="0.35"/>
                                    <Border Canvas.Left="{Binding LoopLeft}" Width="{Binding LoopWidth}" Height="{Binding ActualHeight, ElementName=TimelineGrid}" BorderBrush="{DynamicResource Playhead}" BorderThickness="2,0,2,0"/>
                                </Canvas>

                                <!-- Chords: position and width follow time -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Chords}" Margin="0,8,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChordRowViewModel}">
                                            <!-- Fills the chord row; smaller text (name, degree, shape only) while the timeline is low -->
                                            <Border Width="{Binding Width}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Background="{Binding Color}" CornerRadius="6" ToolTip="{Binding ToolTip}" Cursor="Hand" MouseLeftButtonUp="OnChordClicked">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Padding" Value="10,6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsTimelineCompact, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                <Setter Property="Padding" Value="8,3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="24"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsTimelineCompact, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                        <Setter Property="FontSize" Value="18"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- コード名＋ディグリー: the degree below the name -->
                                                    <TextBlock Text="{Binding Degree}" Foreground="#F0FFFFFF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="{Binding HasDegree, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="15"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsTimelineCompact, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                        <Setter Property="FontSize" Value="12"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding StartText}" Foreground="#E0FFFFFF" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsTimelineCompact, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- With a capo: the shape to fret -->
                                                    <TextBlock Text="{Binding ShapeText}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="14"/>
                                                                <Setter Property="Margin" Value="0,4,0,0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsTimelineCompact, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                        <Setter Property="FontSize" Value="12"/>
                                                                        <Setter Property="Margin" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Detected notes under each chord -->
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Chords}" Margin="0,8,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChordRowViewModel}">
                                            <TextBlock Width="{Binding Width}" Padding="12,0" Text="{Binding Notes}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Lane divider -->
                                <Line Grid.Row="2" X1="0" X2="{Binding TimelineWidth}" Y1="0" Y2="0" VerticalAlignment="Top" Stroke="{DynamicResource TimelineGrid}" StrokeThickness="1.5" StrokeDashArray="2 3"/>

                                <!-- Bar / beat numbers on the ruler: "3" for a bar, "3.2" for its beats (as in the drum editor) -->
                                <ItemsControl Grid.Row="0" ItemsSource="{Binding BeatMarks}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BeatMark}">
                                            <Canvas>
                                                <TextBlock Canvas.Left="6" Text="{Binding Label}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Canvas.Top" Value="7"/>
                                                            <Setter Property="FontSize" Value="15"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBar}" Value="True">
                                                                    <Setter Property="Canvas.Top" Value="3"/>
                                                                    <Setter Property="FontSize" Value="20"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Playhead: end of the audio analysed so far -->
                                <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                                    <Rectangle Canvas.Left="{Binding PlayheadLeft}" Width="2" Height="{Binding ActualHeight, ElementName=TimelineGrid}" Fill="{DynamicResource Playhead}"/>
                                </Canvas>

                                <!-- Playback position -->
                                <Canvas Grid.RowSpan="3" IsHitTestVisible="False" Visibility="{Binding HasPlayback, Converter={StaticResource BoolToVisibility}}">
                                    <Rectangle Canvas.Left="{Binding PlaybackLeft}" Width="3" Height="{Binding ActualHeight, ElementName=TimelineGrid}" Fill="{DynamicResource TextPrimary}"/>
                                </Canvas>

                                <!-- Ruler hit area: drag to choose the loop range, drag its ends to change it, click to move the playback there -->
                                <Border x:Name="LoopRuler" Grid.Row="0" Background="Transparent" Cursor="IBeam"
                                        IsEnabled="{Binding HasPlayback}"
                                        ToolTip="ドラッグでループ区間を指定（端をドラッグで調整・クリックでその位置へ移動）"
                                        MouseLeftButtonDown="OnLoopRulerMouseDown" MouseMove="OnLoopRulerMouseMove"
                                        MouseLeftButtonUp="OnLoopRulerMouseUp" LostMouseCapture="OnLoopRulerLostCapture"/>
                            </Grid>
                        </ScrollViewer>
                        <!-- Hint in the middle of the empty timeline (outside the ScrollViewer so it stays centred) -->
                        <TextBlock Text="{Binding PlaceholderText}" FontSize="18" IsHitTestVisible="False" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Fretboard panel (指板), opened with the button in the timeline header: chord form / scale tabs -->
                <Border x:Name="FretboardCard" Grid.Row="2" ClipToBounds="True" VerticalAlignment="Bottom" SizeChanged="OnFretboardSpaceChanged"
                        Visibility="{Binding IsFretboardOpen, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Margin" Value="0,16,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTimelineHidden}" Value="True">
                                    <Setter Property="Margin" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel Margin="20,10,20,12">
                        <!-- Resize grip: drag the top edge up to enlarge the panel; past the largest size the timeline closes (double-click resets) -->
                        <Thumb DockPanel.Dock="Top" Height="14" Margin="0,-10,0,0" Cursor="SizeNS"
                               DragStarted="OnFretboardResizeStarted" DragDelta="OnFretboardResizeDrag" MouseDoubleClick="OnFretboardResizeReset"
                               ToolTip="上へドラッグで指板を大きく（さらに上げるとコード進行を閉じて大きく表示）。ダブルクリックで元に戻す">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                        <Rectangle x:Name="Grip" Width="56" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource ControlBorder}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Grip" Property="Fill" Value="{DynamicResource Playhead}"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="Grip" Property="Fill" Value="{DynamicResource Playhead}"/>
                                            <Setter TargetName="Grip" Property="Width" Value="80"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <!-- Header: title, tabs, now playing -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="指板" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <Border Margin="18,0,0,0" Padding="3" CornerRadius="7" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentTab}" GroupName="FretboardTab" Content="コードフォーム" IsChecked="{Binding IsChordFormTab}"/>
                                        <RadioButton Style="{StaticResource SegmentTab}" GroupName="FretboardTab" Content="スケール" IsChecked="{Binding IsScaleTab}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Selectors in the header (as in the design): the scale (scale tab only) and the label (both tabs) -->
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Style="{StaticResource ThemedComboBox}" Width="200" Height="36" FontSize="14" Margin="14,0,0,0"
                                              ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale}" DisplayMemberPath="Label"
                                              IsEnabled="{Binding HasFretboard}" Visibility="{Binding IsScaleTab, Converter={StaticResource BoolToVisibility}}">
                                        <ComboBox.ToolTip>
                                            <TextBlock>
                                                <Run Text="{Binding ScaleTitle, Mode=OneWay}" FontWeight="SemiBold"/><LineBreak/>
                                                <Run Text="どれを選んでも、推定したキーから外れない音だけを表示します（C メジャーでマイナー・ペンタ → A マイナー・ペンタ）"/>
                                            </TextBlock>
                                        </ComboBox.ToolTip>
                                    </ComboBox>
                                    <ComboBox Style="{StaticResource ThemedComboBox}" Width="180" Height="36" FontSize="14" Margin="10,0,0,0"
                                              ItemsSource="{Binding FretLabels}" SelectedItem="{Binding SelectedFretLabel}" DisplayMemberPath="Label"
                                              ToolTip="点の中に書く文字。度数は、スケールではスケールのルート、コードフォームではコードのルートからの音程"/>
                                </StackPanel>
                                <Button Style="{StaticResource SmallButton}" Margin="14,0,0,0" Command="{Binding ShowTimelineCommand}"
                                        Visibility="{Binding IsTimelineHidden, Converter={StaticResource BoolToVisibility}}" ToolTip="コード進行を表示して、指板を元の大きさに戻します">
                                    <StackPanel Orientation="Horizontal" Margin="12,0">
                                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Margin="0,1,6,0"/>
                                        <TextBlock Text="コード進行を表示" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Height="40" Padding="14,0" CornerRadius="6"
                                    Background="{DynamicResource NowPlayingBackground}" BorderBrush="{DynamicResource NowPlayingBorder}" BorderThickness="1"
                                    Visibility="{Binding HasPlayback, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource NowPlayingDot}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding NowPlayingState}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,1,10,0"/>
                                    <TextBlock Text="{Binding NowPlayingChord}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NowPlayingDegree}" FontSize="14" Foreground="{DynamicResource KeyBadgeLabel}" VerticalAlignment="Center" Margin="8,3,0,0"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="6,2,0,0">
                                        <Run Text="・"/><Run Text="{Binding NowPlayingTime, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>


                        <Grid>
                            <!-- ===== Chord form tab ===== -->
                            <Grid Visibility="{Binding IsChordFormTab, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Small chord diagram; as tall as the neck side, so the neck decides the panel height -->
                                <Border Grid.Column="0" VerticalAlignment="Top" Height="{Binding ActualHeight, ElementName=ChordFormRight}" CornerRadius="8" Padding="12,6" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                    <DockPanel>
                                        <!-- Name and the alternate-form button on one row, so the diagram keeps its height -->
                                        <DockPanel DockPanel.Dock="Top">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                    Content="{Binding AlternateFormText}" Command="{Binding NextChordFormCommand}"
                                                    ToolTip="同じコードの別の押さえ方に切り替えます"/>
                                            <TextBlock Text="{Binding ChordFormName}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <!-- TAB text, and with a capo the sounding chord -->
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding ChordFormText}" FontSize="12" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource KeyBadgeLabel}" TextTrimming="CharacterEllipsis">
                                                <Run Text=" ・ "/><Run Text="{Binding ChordFormSub, Mode=OneWay}"/>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ChordFormSub}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- Grows with the panel (keeps its proportions) -->
                                        <Viewbox Stretch="Uniform" Margin="0,2,0,0" HorizontalAlignment="Center">
                                            <views:ChordDiagramView Width="150" Height="122"
                                                                    Form="{Binding CurrentChordForm}" Dots="{Binding ChordDiagramDots}"
                                                                    LineBrush="{DynamicResource FretLine}" LabelBrush="{DynamicResource TextSecondary}"
                                                                    ToneBrush="{DynamicResource FretScaleNote}" RootBrush="{DynamicResource FretScaleRoot}"/>
                                        </Viewbox>
                                    </DockPanel>
                                </Border>

                                <DockPanel Grid.Column="2" x:Name="ChordFormRight" VerticalAlignment="Top">
                                    <!-- Detected notes and legend on one row (as tall as the scale tab's legend); wraps when narrow -->
                                    <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="34,6,0,0">
                                        <WrapPanel.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="5,0,16,0"/>
                                            </Style>
                                        </WrapPanel.Resources>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                            <TextBlock Text="検出した音" Margin="0,0,8,0"/>
                                            <ItemsControl ItemsSource="{Binding DetectedNotes}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:DetectedNoteChip}">
                                                        <Grid Margin="0,0,6,0" MinWidth="38">
                                                            <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1.4">
                                                                <Rectangle.Style>
                                                                    <Style TargetType="Rectangle">
                                                                        <Setter Property="Fill" Value="{DynamicResource FretChip}"/>
                                                                        <Setter Property="Stroke" Value="{DynamicResource FretScaleNote}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsChordTone}" Value="False">
                                                                                <Setter Property="Fill" Value="Transparent"/>
                                                                                <Setter Property="Stroke" Value="{DynamicResource TextMuted}"/>
                                                                                <Setter Property="StrokeDashArray" Value="2 2"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Rectangle.Style>
                                                            </Rectangle>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="9,0" HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsChordTone}" Value="False">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="22" Height="12" CornerRadius="6" Background="{DynamicResource FretScaleRoot}"/><TextBlock Text="ルート"/>
                                            <Border Width="22" Height="12" CornerRadius="6" Background="{DynamicResource FretScaleNote}"/><TextBlock Text="押さえる構成音"/>
                                            <Border Width="22" Height="12" CornerRadius="6" Background="{DynamicResource FretScaleNoteFill}" BorderBrush="{DynamicResource FretScaleNoteRing}" BorderThickness="1"/><TextBlock Text="別の場所"/>
                                            <Rectangle Width="22" Height="12" RadiusX="6" RadiusY="6" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.4" StrokeDashArray="2 2"/><TextBlock Text="コード外の音"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Grid Height="{Binding FretboardHeight}">
                                        <views:FretboardView Marks="{Binding ChordFormMarks}" MutedStrings="{Binding ChordFormMutedStrings}" Capo="{Binding Capo}" FretCount="{Binding ChordFormFretCount}"
                                                             BoardBrush="{DynamicResource FretBoard}" LineBrush="{DynamicResource FretLine}" LabelBrush="{DynamicResource TextSecondary}"
                                                             ScaleNoteBrush="{DynamicResource FretScaleNote}" ScaleRootBrush="{DynamicResource FretScaleRoot}"
                                                             ScaleNoteFillBrush="{DynamicResource FretScaleNoteFill}" ScaleNoteRingBrush="{DynamicResource FretScaleNoteRing}"
                                                             OutsideToneBrush="{DynamicResource FretOutsideTone}"/>
                                    </Grid>
                                </DockPanel>

                                <!-- No chord under the playback position -->
                                <Border Grid.ColumnSpan="3" Background="{DynamicResource CardBackground}" Opacity="0.9" Visibility="{Binding HasChordForm, Converter={StaticResource InvertedBoolToVisibility}}">
                                    <TextBlock Text="{Binding ChordFormHint}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                </Border>
                            </Grid>

                            <!-- ===== Scale tab ===== -->
                            <DockPanel Visibility="{Binding IsScaleTab, Converter={StaticResource BoolToVisibility}}">
                                <!-- Legend -->
                                <!-- Hidden (not collapsed) before analysis, so the panel is as tall as the chord-form tab -->
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="34,6,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFretboard}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="5,0,16,0"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Border Width="22" Height="12" CornerRadius="6" Background="{DynamicResource FretScaleRoot}"
                                            ToolTip="再生中のコードのルート（コードがないときはスケールのルート）"/><TextBlock Text="ルート"/>
                                    <Border Width="22" Height="12" CornerRadius="6" Background="{DynamicResource FretScaleNote}"/><TextBlock Text="コード構成音"/>
                                    <Border Width="22" Height="12" CornerRadius="6" Background="{DynamicResource FretScaleNoteFill}" BorderBrush="{DynamicResource FretScaleNoteRing}" BorderThickness="1"/><TextBlock Text="スケール音"/>
                                    <Rectangle Width="22" Height="12" RadiusX="6" RadiusY="6" Stroke="{DynamicResource FretOutsideTone}" StrokeThickness="1.5" StrokeDashArray="2 1"/><TextBlock Text="スケール外の構成音"/>
                                </StackPanel>
                                <Grid Height="{Binding FretboardHeight}">
                                    <views:FretboardView Marks="{Binding FretboardMarks}" Capo="{Binding Capo}" FretCount="{x:Static vm:ChordDetectionViewModel.ScaleFretCount}"
                                                         BoardBrush="{DynamicResource FretBoard}" LineBrush="{DynamicResource FretLine}" LabelBrush="{DynamicResource TextSecondary}"
                                                         ScaleNoteBrush="{DynamicResource FretScaleNote}" ScaleRootBrush="{DynamicResource FretScaleRoot}"
                                                         ScaleNoteFillBrush="{DynamicResource FretScaleNoteFill}" ScaleNoteRingBrush="{DynamicResource FretScaleNoteRing}"
                                                         OutsideToneBrush="{DynamicResource FretOutsideTone}"/>
                                    <Border Background="{DynamicResource CardBackground}" Opacity="0.85" Visibility="{Binding HasFretboard, Converter={StaticResource InvertedBoolToVisibility}}">
                                        <TextBlock Text="{Binding FretboardHint}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Chord sheet: one cell per bar (shown for takes recorded with 小節に合わせる) -->
                <Border x:Name="BarSheetCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" ClipToBounds="True" Visibility="{Binding HasBars, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="40" Margin="20,10,20,4">
                            <TextBlock Text="コード譜（小節ごと）" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding BarSheetInfo}" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,20,14">
                            <ItemsControl ItemsSource="{Binding Bars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="4" VerticalAlignment="Top"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BarRowViewModel}">
                                        <Border MinHeight="76" BorderBrush="{DynamicResource CardBorder}" BorderThickness="2,0,0,1" Padding="10,4,8,6" Background="Transparent" Cursor="Hand" ToolTip="{Binding ToolTip}" MouseLeftButtonUp="OnBarClicked">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Number}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                                <ItemsControl ItemsSource="{Binding Slots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:BarSlotViewModel}">
                                                            <StackPanel VerticalAlignment="Bottom">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding ShapeText}" FontSize="13" Margin="6,0,0,5" VerticalAlignment="Bottom" Foreground="{DynamicResource TextSecondary}"/>
                                                                </StackPanel>
                                                                <!-- コード名＋ディグリー: the degree below the name -->
                                                                <TextBlock Text="{Binding Sub}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasSub, Converter={StaticResource BoolToVisibility}}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                </Grid>

            </Grid>
        </DockPanel>
</UserControl>
