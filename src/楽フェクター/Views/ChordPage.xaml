<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:ChordDetection.App.ViewModels" xmlns:views="clr-namespace:ChordDetection.App.Views" x:Class="FXForge.Views.ChordPage" Background="{DynamicResource WindowBackground}" FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" Foreground="{DynamicResource TextPrimary}" AllowDrop="True" DragOver="OnAudioDragOver" Drop="OnAudioDrop">
  <UserControl.Resources><ResourceDictionary>
            <!-- Index 0 is the theme; MainWindow replaces it when ダークモード is switched. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ChordDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="UiFont">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <views:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility"/>

            <!-- Rounded card (マイク入力 / timeline). -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <Style x:Key="Icon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Flat button: dark fill with a thin border (クリア). -->
            <Style x:Key="FlatButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Height" Value="64"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 録音開始 / 停止して解析. -->
            <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Background" Value="{DynamicResource RecordBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource RecordBackground}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RecordHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small button in the developer section. -->
            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- Sidebar item: icon above the label; the checked one is highlighted. -->
            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource SidebarText}"/>
                <Setter Property="Height" Value="108"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarActiveBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- On/off switch (ダークモード). -->
            <Style x:Key="Switch" TargetType="ToggleButton">
                <Setter Property="Width" Value="68"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Track" CornerRadius="19" Background="{DynamicResource MeterOff}">
                                <Ellipse x:Name="Knob" Width="30" Height="30" Fill="White" Margin="4,0" HorizontalAlignment="Left"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource SwitchOn}"/>
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBox that follows the theme (the default template ignores Background on Windows 10/11). -->
            <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
                <Border Background="Transparent">
                    <TextBlock Text="" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimary}"/>
                </Border>
            </ControlTemplate>

            <Style x:Key="ThemedComboBox" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Height" Value="58"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/>
                                <ContentPresenter Margin="20,0,40,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="300">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd" Padding="16,8" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Smaller ComboBox for the developer section. -->
            <Style x:Key="SmallComboBox" TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- Option in 設定 (歪み / 音源分離). -->
            <Style x:Key="SettingCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DevCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
  <DockPanel><TextBlock x:Name="InitErrorText" DockPanel.Dock="Top" Visibility="Collapsed" Background="#52251F" Foreground="#FFD5B7" Padding="16" Margin="20,12,20,0" TextWrapping="Wrap"/><Grid Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- マイク入力 / 設定 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,24,24,28">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource Icon}" FontSize="22" Margin="0,0,12,0" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="マイク入力" Style="{StaticResource CardTitle}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Ellipse Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{Binding StateColor}"/>
                            <TextBlock Text="{Binding StateLabel}" FontSize="18" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <views:LevelMeter Height="20" Margin="0,16,0,0" Level="{Binding InputLevel}" Segments="22" OffBrush="{DynamicResource MeterOff}" OnBrush="{DynamicResource MeterOn}" ToolTip="入力レベル"/>

                        <!-- ギター直結: FX Forge の共通音声入力（ASIO） -->
                        <CheckBox Style="{StaticResource SettingCheckBox}" Margin="0,18,0,0" Content="ASIO で録音（ギター直結）" IsChecked="{Binding UseAsio}" IsEnabled="{Binding IsIdle}" ToolTip="オーディオインターフェースの ASIO ドライバーから、ギターをつないだ入力を録音します"/>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding UseAsio, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ASIO入力はアプリ右上の ⚙ で設定（他の機能と共有）" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,8"/><TextBlock Text="{Binding InputGainText}" FontSize="13" Margin="0,4,0,2" Foreground="{DynamicResource TextMuted}"/>
                            <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding InputGainDb}" ToolTip="ギターの音が小さいときに上げます（録音中も変更可）"/>
                        </StackPanel>

                        <Button Margin="0,22,0,0" Style="{StaticResource RecordButton}" Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}"/>
                        <Button Margin="0,12,0,0" Style="{StaticResource FlatButton}" Command="{Binding OpenAudioFileCommand}" ToolTip="WAV / MP3 / M4A / AAC / WMA / FLAC を開いて解析します（タイムラインへのドラッグ＆ドロップでも開けます）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="音声ファイルを開く…"/>
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource FlatButton}" Content="{Binding PlayButtonText}" Command="{Binding TogglePlaybackCommand}" ToolTip="解析した音を再生します（音源分離したときも元の音）。タイムラインのコードをクリックすると、そこから再生します"/>
                            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="■  停止" Command="{Binding StopPlaybackCommand}" ToolTip="停止して先頭に戻ります"/>
                        </Grid>
                        <TextBlock Text="{Binding PlaybackTimeText}" FontSize="15" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                        <Button Margin="0,12,0,0" Style="{StaticResource FlatButton}" Content="クリア" Command="{Binding ClearCommand}"/>

                        <Border Height="1" Margin="0,34,0,24" Background="{DynamicResource CardBorder}"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource Icon}" FontSize="20" FontWeight="Bold" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="設定" Style="{StaticResource CardTitle}"/>
                        </StackPanel>

                        <TextBlock Text="チューニング" FontSize="18" Margin="0,20,0,12" Foreground="{DynamicResource TextPrimary}"/>
                        <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding Tunings}" SelectedItem="{Binding SelectedTuning}" IsEnabled="{Binding IsIdle}" ToolTip="基準ピッチ（現在は表示のみ。解析は 440Hz 固定です）"/>

                        <CheckBox Style="{StaticResource SettingCheckBox}" Margin="0,20,0,0" Content="音作りした音（歪み）" IsChecked="{Binding IsToneShaped}" IsEnabled="{Binding IsIdle}" ToolTip="歪ませた音向け。歪みで弱くなった弾いた音も拾うように、音の検出の条件を緩めます（次の解析から有効）"/>
                        <CheckBox Style="{StaticResource SettingCheckBox}" Margin="0,14,0,0" Content="音源分離（Demucs）して解析" IsChecked="{Binding UseSourceSeparation}" IsEnabled="{Binding IsSeparationAvailable}" ToolTip="{Binding SeparationToolTip}" ToolTipService.ShowOnDisabled="True"/>
                        <ComboBox Style="{StaticResource ThemedComboBox}" Height="44" FontSize="16" Margin="30,10,0,0" ItemsSource="{Binding Stems}" SelectedItem="{Binding SelectedStem}" DisplayMemberPath="Label" IsEnabled="{Binding UseSourceSeparation}" ToolTip="音源分離のあとに解析するトラック（ファイルを開いたときに有効）"/>

                        <!-- Demo / evaluation features that are not part of the product screen. -->
                        <Expander Margin="0,24,0,0" FontSize="14">
                            <Expander.Header>
                                <TextBlock Text="詳細設定（開発用）" Foreground="{DynamicResource TextSecondary}"/>
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="入力デバイス" FontSize="13" Margin="0,0,0,4" Foreground="{DynamicResource TextMuted}"/>
                                <ComboBox Style="{StaticResource SmallComboBox}" ItemsSource="{Binding InputDevices}" SelectedIndex="{Binding SelectedDeviceIndex}" IsEnabled="{Binding IsIdle}" ToolTip="録音する入力デバイス（ギターをつないだオーディオインターフェース）"/>
                                <CheckBox Style="{StaticResource DevCheckBox}" Margin="0,6,0,6" Content="クロマ方式で解析（比較用）" IsChecked="{Binding UseChroma}" IsEnabled="{Binding IsIdle}" ToolTip="Basic Pitch を使わず、12音の強さ（クロマ）からコードを判定します。今の方式と結果を比べるために使います（次の解析から有効。「音作りした音」の設定は効きません）"/>
                                <Button Style="{StaticResource SmallButton}" Content="音のリストをCSV保存…" Command="{Binding ExportNotesCommand}" ToolTip="公式Python版との比較用（tools/compare_notes.py）"/>
                                <Button Style="{StaticResource SmallButton}" Content="解析をキャンセル" Command="{Binding CancelAnalysisCommand}" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Timeline -->
                <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True" VerticalAlignment="Top">
                    <DockPanel>
                        <!-- Status / result (the blank area under the scroll bar in the design). -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,14">
                            <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding AnalysisProgress, Mode=OneWay}" Foreground="{DynamicResource Playhead}" Background="{DynamicResource MeterOff}" BorderThickness="0" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}"/>
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding SourceName, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding SummaryText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled">
                            <Grid Width="{Binding TimelineWidth}" Height="436" HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="52"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Ruler: mm:ss every second -->
                                <ItemsControl Grid.Row="0" ItemsSource="{Binding Ticks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineTick}">
                                            <Canvas>
                                                <TextBlock Canvas.Left="6" Canvas.Top="12" Text="{Binding Label}" FontSize="15" Foreground="{DynamicResource TextMuted}"/>
                                                <Rectangle Canvas.Top="40" Width="1.5" Height="12" Fill="{DynamicResource TextMuted}"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource CardBorder}"/>

                                <!-- Chords: position and width follow time -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Chords}" Margin="0,16,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChordRowViewModel}">
                                            <Border Width="{Binding Width}" Height="150" Background="{Binding Color}" CornerRadius="6" Padding="12,10" ToolTip="{Binding ToolTip}" Cursor="Hand" MouseLeftButtonUp="OnChordClicked">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StartText}" Foreground="#E0FFFFFF" FontSize="13" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Detected notes under each chord -->
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Chords}" Margin="0,16,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChordRowViewModel}">
                                            <TextBlock Width="{Binding Width}" Padding="12,0" Text="{Binding Notes}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Lane divider -->
                                <Line Grid.Row="2" X1="0" X2="{Binding TimelineWidth}" Y1="0" Y2="0" VerticalAlignment="Top" Stroke="{DynamicResource TimelineGrid}" StrokeThickness="1.5" StrokeDashArray="2 3"/>

                                <!-- Playhead: end of the audio analysed so far -->
                                <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                                    <Rectangle Canvas.Left="{Binding PlayheadLeft}" Width="2" Height="436" Fill="{DynamicResource Playhead}"/>
                                </Canvas>

                                <!-- Playback position -->
                                <Canvas Grid.RowSpan="3" IsHitTestVisible="False" Visibility="{Binding HasPlayback, Converter={StaticResource BoolToVisibility}}">
                                    <Rectangle Canvas.Left="{Binding PlaybackLeft}" Width="3" Height="436" Fill="{DynamicResource TextPrimary}"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Hint in the middle of the empty timeline (outside the ScrollViewer so it stays centred). -->
                <TextBlock Grid.Column="2" Text="{Binding PlaceholderText}" FontSize="18" IsHitTestVisible="False" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,286,0,0"/>
            </Grid>
        </DockPanel>
</UserControl>
