<UserControl x:Class="FXForge.Views.TunerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#F1F4F8">
    <Border Margin="36,18" Background="#080F16" BorderBrush="#223442"
            BorderThickness="1" CornerRadius="24" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="?" Click="Help_Click"
                        Padding="10,4" VerticalAlignment="Top"/>
                <Border BorderBrush="#253747" BorderThickness="1"
                        CornerRadius="10,10,40,10" Width="240"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Padding="20,12">
                    <TextBlock Text="チ ュ ー ナ ー" FontSize="28"/>
                </Border>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <!-- 左：既存の単音メーター。変更なし -->
                <Border Background="#0B141D" BorderBrush="#233647"
                        BorderThickness="1" CornerRadius="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="140"/>
                        </Grid.RowDefinitions>
                        <Canvas x:Name="MeterCanvas" SizeChanged="Meter_SizeChanged" MinHeight="260"/>
                        <Border Grid.Row="1" Background="#090F16" BorderBrush="#223645"
                                BorderThickness="1" CornerRadius="18" Margin="90,0,90,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="NoteText" Text="— —" FontSize="48"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FrequencyText" Text="— Hz" Foreground="#26BAFF"
                                           FontSize="23" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右：既存の「ずれ」「基準ピッチ」の下に6弦メーターを追加 -->
                <Border Grid.Column="2" Background="#0B141D" BorderBrush="#233647"
                        BorderThickness="1" CornerRadius="18" Padding="18,20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="ずれ" FontSize="20"/>
                                <TextBlock x:Name="CentsText" Text="—" FontSize="30"
                                           Foreground="#22B6FF" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#293A4A" Margin="0,14"/>
                            <Grid>
                                <TextBlock Text="基準ピッチ" FontSize="20"/>
                                <TextBlock Text="440.0" FontSize="30" Foreground="#22B6FF"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#293A4A" Margin="0,14"/>
                            <TextBlock x:Name="TunerStatusText" Text="入力待機中"
                                       Foreground="#7F95A8" TextWrapping="Wrap"/>

                            <Border Height="1" Background="#293A4A" Margin="0,16"/>
                            <DockPanel Margin="0,0,0,6">
                                <ToggleButton x:Name="PolyTunerToggle"
              DockPanel.Dock="Right"
              Content="OFF"
              IsChecked="False"
              Click="PolyTunerToggle_Click"
              Width="88" Height="34"
              Margin="10,0,0,0"
              Cursor="Hand"
              ToolTip="6弦同時解析のON／OFF">

                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="SwitchBorder"
                    Background="#101D28"
                    BorderBrush="#304858"
                    BorderThickness="1"
                    CornerRadius="17">
                                                <Grid Margin="11,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ContentPresenter x:Name="SwitchText"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      TextElement.Foreground="#8FA7B7"
                                      TextElement.FontSize="11"
                                      TextElement.FontWeight="SemiBold"/>

                                                    <Ellipse x:Name="Indicator"
                             Grid.Column="1"
                             Width="10" Height="10"
                             Fill="#536A7A"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <!-- ON -->
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="SwitchBorder"
                            Property="Background" Value="#12352E"/>
                                                    <Setter TargetName="SwitchBorder"
                            Property="BorderBrush" Value="#32D3A0"/>
                                                    <Setter TargetName="SwitchText"
                            Property="TextElement.Foreground"
                            Value="#B9F8DE"/>
                                                    <Setter TargetName="Indicator"
                            Property="Fill" Value="#32D3A0"/>
                                                    <Setter TargetName="Indicator" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#32D3A0"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.65"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>

                                                <!-- マウスを重ねたとき -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SwitchBorder"
                            Property="BorderBrush" Value="#26BAFF"/>
                                                </Trigger>

                                                <!-- 押しているとき -->
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="SwitchBorder"
                            Property="Opacity" Value="0.75"/>
                                                </Trigger>

                                                <!-- キーボード操作時 -->
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="SwitchBorder"
                            Property="BorderBrush" Value="#26BAFF"/>
                                                </Trigger>

                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="SwitchBorder"
                            Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </DockPanel>
                            <TextBlock Text="開放弦 / E A D G B E" FontSize="11"
                                       Foreground="#8FA7B7" Margin="0,3,0,12"/>

                            <!-- 各行はViewModelで動的更新 -->
                            <ItemsControl x:Name="StringMeterList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StringLabel}" FontSize="12"
                                                           Foreground="#C1D0DE"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SoundText}"
                                                           FontSize="11" Foreground="#CADAE6"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CentText}"
                                                           FontSize="11" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" Foreground="{Binding Accent}"/>
                                            </Grid>
                                            <Canvas Width="240" Height="16" HorizontalAlignment="Left">
                                                <Border Canvas.Top="5" Width="240" Height="6"
                                                        Background="#263A49" CornerRadius="3"/>
                                                <!-- ±5centの範囲 -->
                                                <Border Canvas.Left="108" Canvas.Top="5"
                                                        Width="24" Height="6" Background="#215D4C"
                                                        CornerRadius="2"/>
                                                <!-- 中央の0centライン -->
                                                <Border Canvas.Left="119" Canvas.Top="0" Width="2"
                                                        Height="16" Background="#95A8B7"/>
                                                <!-- 解析結果の針 -->
                                                <Border Canvas.Left="{Binding MarkerLeft}"
                                                        Canvas.Top="1" Width="8" Height="14"
                                                        Background="{Binding Accent}"
                                                        Visibility="{Binding MarkerVisibility}"
                                                        CornerRadius="3"/>
                                            </Canvas>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Width="240" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="−50" FontSize="10" Foreground="#8299AB"/>
                                <TextBlock Text="0" FontSize="10" Foreground="#8299AB"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="+50 cent" FontSize="10" Foreground="#8299AB"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="緑：±5 cent以内 / 青：調整が必要"
                                       FontSize="10" Foreground="#8299AB" TextWrapping="Wrap"/>
                            <TextBlock Text="※検出できない弦は『未検出』と表示"
                                       FontSize="10" Foreground="#8299AB" TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
