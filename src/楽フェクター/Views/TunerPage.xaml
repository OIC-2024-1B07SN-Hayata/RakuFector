<UserControl x:Class="FXForge.Views.TunerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#F1F4F8">
    <Border Margin="36,18" Background="#080F16" BorderBrush="#223442" BorderThickness="1" CornerRadius="24" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="?" Click="Help_Click" Padding="10,4" VerticalAlignment="Top"/>
                <Border BorderBrush="#253747" BorderThickness="1" CornerRadius="10,10,40,10" Width="240" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="20,12">
                    <TextBlock Text="チ ュ ー ナ ー" FontSize="28"/>
                </Border>
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>
                <Border Background="#0B141D" BorderBrush="#233647" BorderThickness="1" CornerRadius="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="140"/>
                        </Grid.RowDefinitions>
                        <Canvas x:Name="MeterCanvas" SizeChanged="Meter_SizeChanged" MinHeight="260"/>
                        <Border Grid.Row="1" Background="#090F16" BorderBrush="#223645" BorderThickness="1" CornerRadius="18" Margin="90,0,90,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="NoteText" Text="— —" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FrequencyText" Text="— Hz" Foreground="#26BAFF" FontSize="23" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="#0B141D" BorderBrush="#233647" BorderThickness="1" CornerRadius="18" Padding="22,36">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ずれ" FontSize="20"/>
                            <TextBlock x:Name="CentsText" Text="—" FontSize="30" Foreground="#22B6FF" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="1" Background="#293A4A" Margin="0,24"/>
                        <Grid>
                            <TextBlock Text="基準ピッチ" FontSize="20"/>
                            <TextBlock Text="440.0" FontSize="30" Foreground="#22B6FF" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="1" Background="#293A4A" Margin="0,24"/>
                        <TextBlock x:Name="TunerStatusText" Text="入力待機中" Foreground="#7F95A8" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
