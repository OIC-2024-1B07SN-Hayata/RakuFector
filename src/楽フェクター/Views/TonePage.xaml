<UserControl x:Class="FXForge.Views.TonePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FXForge.Controls" Foreground="#EDF2F7">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="176"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#10151B" BorderBrush="#2B343F" BorderThickness="1" CornerRadius="16" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel><Button DockPanel.Dock="Right" Content="?" Click="Help_Click" Padding="8,1"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,16,0">
    <Button Content="原音" Tag="Raw" Click="QuickPreset_Click" Padding="12,5" Margin="0,0,6,0"/>
    <Button Content="AMP" Tag="Amp" Click="QuickPreset_Click" Padding="12,5" Margin="0,0,6,0"/>
    <Button Content="SD-1 + AMP" Tag="Sd1" Click="QuickPreset_Click" Padding="12,5" Margin="0,0,6,0"/>
    <Button Content="RAT + AMP" Tag="Rat" Click="QuickPreset_Click" Padding="12,5"/>
   </StackPanel><TextBlock Text="SIGNAL CHAIN" Foreground="#8092A3" VerticalAlignment="Center"/></DockPanel>
   <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,14,0,0"><ItemsControl ItemsSource="{Binding Effects}" Width="1155" Height="96"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
     <Button Tag="{Binding}" Click="EffectButton_Click" PreviewMouseLeftButtonDown="Effect_MouseDown" PreviewMouseMove="Effect_MouseMove" AllowDrop="True" Drop="Effect_Drop" Background="#141B22" BorderBrush="{Binding ActiveAccentBrush}" BorderThickness="1.5" Padding="12,8">
      <StackPanel HorizontalAlignment="Stretch"><DockPanel><Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="{Binding ActiveAccentBrush}"/><TextBlock Text="{Binding Category}" Foreground="{Binding ActiveAccentBrush}" FontSize="9"/></DockPanel><TextBlock Text="{Binding ShortName}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6"/><TextBlock Text="{Binding SlotName}" Foreground="#71808F" FontSize="10"/></StackPanel>
     </Button><TextBlock Grid.Column="1" Text="›" Foreground="#3D4C5B" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Viewbox>
  </Grid></Border>
  <Border Grid.Row="2" Background="#10151B" BorderBrush="#2B343F" BorderThickness="1" CornerRadius="16" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="{Binding SelectedEffect.ActiveAccentBrush}" CornerRadius="3"/>
    <StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedEffect.ShortName}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text=" / " FontSize="23" Foreground="#677787"/><TextBlock Text="{Binding SelectedEffect.Name}" FontSize="22" Foreground="#C8D4E0" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding SelectedEffect.HasTypeChoices,Converter={StaticResource BoolToVisibility}}"><TextBlock Text="エフェクト種類" Foreground="#8394A5" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox Width="210" ItemsSource="{Binding SelectedEffect.AvailablePresets}" SelectedItem="{Binding SelectedEffect.SelectedPreset,Mode=TwoWay}" DisplayMemberPath="ShortName" Background="#E6E6E6" Foreground="#52606D"/></StackPanel>
    </StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ON / OFF" Foreground="#8EA2B6" Margin="0,0,16,0"/><CheckBox Content="ON" IsChecked="{Binding SelectedEffect.IsEnabled,Mode=TwoWay}"/></StackPanel>
   </Grid><Border Grid.Row="1" Background="#293340"/>
   <ItemsControl Grid.Row="2" ItemsSource="{Binding SelectedEffect.Parameters}" Width="900" HorizontalAlignment="Center" Margin="30,0" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="8,0" HorizontalAlignment="Center"><controls:Knob Width="160" Height="160" Value="{Binding Value,Mode=TwoWay}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Accent="{Binding DataContext.SelectedEffect.ActiveAccentBrush,RelativeSource={RelativeSource AncestorType=UserControl}}"/><TextBlock Text="{Binding Name}" FontSize="18" HorizontalAlignment="Center" Margin="0,18,0,0"/><TextBlock Text="{Binding Unit}" Foreground="#778898" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Grid.Row="3" Content="?" Click="Help_Click" Padding="8,2" HorizontalAlignment="Left"/>
  </Grid></Border>
 </Grid>
</UserControl>
