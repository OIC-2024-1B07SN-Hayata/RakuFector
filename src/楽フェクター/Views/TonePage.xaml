<UserControl
    x:Class="FXForge.Views.TonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FXForge.Controls"
    Background="#0B1016"
    Foreground="#EDF2F7"
    FontFamily="Segoe UI"
    Loaded="XyPage_Loaded"
    Unloaded="XyPage_Unloaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ToneBoolToVisibility"/>

        <Style x:Key="ToneButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EDF2F7"/>
            <Setter Property="Background" Value="#1A2531"/>
            <Setter Property="BorderBrush" Value="#354657"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#26384A"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#334D65"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToneEffectCard" TargetType="Button">
            <Setter Property="Foreground" Value="#EDF2F7"/>
            <Setter Property="Background" Value="#141D27"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CardBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <!-- 文字や内部余白ではなく、
                                 カード全体でマウス操作を受け取る -->
                            <ContentPresenter
                                IsHitTestVisible="False"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="CardBorder"
                                    Property="Background"
                                    Value="#203040"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="CardBorder"
                                    Property="Background"
                                    Value="#2B4054"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="XyKnobTemplate">
            <StackPanel Width="130" Margin="4,6,4,10">
                <controls:Knob
                    Width="120"
                    Height="120"
                    HorizontalAlignment="Center"
                    Value="{Binding Value, Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                    Minimum="{Binding Minimum}"
                    Maximum="{Binding Maximum}"
                    Step="{Binding Step}"
                    DisplayText="{Binding KnobText}"
                    IsEnabled="{Binding IsEditable}"
                    Accent="{Binding DataContext.SelectedEffect.ActiveAccentBrush,
                                     RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>

                <TextBlock
                    Text="{Binding Name}"
                    FontSize="12"
                    Foreground="#EDF2F7"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="XyLinkedKnobTemplate">
            <StackPanel Width="130" Margin="4,6,4,10">
                <controls:Knob
                    Width="130"
                    Height="130"
                    HorizontalAlignment="Center"
                    Value="{Binding Value, Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                    Minimum="{Binding Minimum}"
                    Maximum="{Binding Maximum}"
                    Step="{Binding Step}"
                    DisplayText="{Binding KnobText}"
                    IsEnabled="{Binding IsEditable}"
                    Accent="{Binding DataContext.SelectedEffect.ActiveAccentBrush,
                                     RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>

                <TextBlock
                    Text="{Binding Name}"
                    FontSize="12"
                    Foreground="#EDF2F7"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="ToneScrollViewer"
        SizeChanged="ToneScrollViewer_SizeChanged"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- シグナルチェーン -->
            <Border
                x:Name="ToneSignalChain"
                Grid.Row="0"
                Padding="20"
                Background="#101720"
                BorderBrush="#2B3948"
                BorderThickness="1"
                CornerRadius="14">

                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button
                            DockPanel.Dock="Right"
                            Margin="12,0,0,0"
                            Style="{StaticResource ToneButton}"
                            Content="使い方"
                            Click="Help_Click"/>

                        <StackPanel>
                            <TextBlock
                                Text="SIGNAL CHAIN"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#AABCCD"/>

                            <TextBlock
                                Margin="0,6,0,0"
                                Text="カードを選択して編集します。DRIVE A / Bはカードをドラッグして順序を交換できます。"
                                Foreground="#8195A8"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl
                        Margin="0,18,0,0"
                        ItemsSource="{Binding Effects}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ドラッグ操作はカード全体で受け取る -->
                                    <Button
                                        Grid.Column="0"
                                        MinHeight="112"
                                        Style="{StaticResource ToneEffectCard}"
                                        BorderBrush="{Binding ActiveAccentBrush}"
                                        Tag="{Binding}"
                                        Click="EffectButton_Click"
                                        PreviewMouseLeftButtonDown="Effect_MouseDown"
                                        PreviewMouseMove="Effect_MouseMove"
                                        PreviewMouseLeftButtonUp="Effect_MouseUp"
                                        LostMouseCapture="Effect_LostMouseCapture"
                                        AllowDrop="True"
                                        PreviewDragEnter="Effect_DragOver"
                                        PreviewDragOver="Effect_DragOver"
                                        PreviewDrop="Effect_Drop">

                                        <StackPanel IsHitTestVisible="False">
                                            <DockPanel>
                                                <Ellipse
                                                    DockPanel.Dock="Right"
                                                    Width="8"
                                                    Height="8"
                                                    Margin="5,0,0,0"
                                                    Fill="{Binding ActiveAccentBrush}"/>

                                                <TextBlock
                                                    Text="{Binding Category}"
                                                    Foreground="{Binding ActiveAccentBrush}"
                                                    FontSize="10"
                                                    TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <TextBlock
                                                Margin="0,14,0,6"
                                                Text="{Binding ShortName}"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"/>

                                            <TextBlock
                                                Text="{Binding SlotName}"
                                                Foreground="#8BA0B3"
                                                FontSize="11"
                                                TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 矢印は表示のみ -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="›"
                                        IsHitTestVisible="False"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#4C6378"
                                        FontSize="25"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 選択中エフェクト -->
            <Border
                Grid.Row="2"
                Padding="22"
                Background="#101720"
                BorderBrush="#2B3948"
                BorderThickness="1"
                CornerRadius="14">

                <Grid
                    x:Name="XyEditor"
                    SizeChanged="XyEditor_SizeChanged">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0"/>
                        <ColumnDefinition Width="0"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="XyEditorHeader"
                        Panel.ZIndex="2"
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,16">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Background="{Binding SelectedEffect.ActiveAccentBrush}"
                            CornerRadius="3"/>

                        <StackPanel
                            Grid.Column="2"
                            Margin="0,0,12,0">

                            <TextBlock
                                Text="{Binding SelectedEffect.SlotName}"
                                Foreground="#8BA0B3"
                                FontSize="12"/>

                            <TextBlock
                                Margin="0,4,0,4"
                                Text="{Binding SelectedEffect.ShortName}"
                                FontSize="30"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"/>

                            <TextBlock
                                Text="{Binding SelectedEffect.Name}"
                                Foreground="#A8BACB"
                                FontSize="14"
                                TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel
                            x:Name="XyHeaderActions"
                            Grid.Column="3"
                            VerticalAlignment="Center">

                            <TextBlock
                                Margin="0,0,0,8"
                                Text="ON / OFF"
                                Foreground="#8BA0B3"
                                FontSize="12"/>

                            <CheckBox
                                Content="ON"
                                Foreground="#EDF2F7"
                                FontSize="17"
                                IsChecked="{Binding SelectedEffect.IsEnabled,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"/>

                            <Button
                                x:Name="XyModeButton"
                                Margin="0,12,0,0"
                                Style="{StaticResource ToneButton}"
                                FontSize="12"
                                Content="XY操作"
                                Visibility="Collapsed"
                                Click="XyModeButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- エフェクト種類とモード切替 -->
                    <WrapPanel
                        x:Name="XyTypeSelector"
                        Grid.ColumnSpan="3"
                        Grid.Row="1"
                        Margin="0"
                        Visibility="{Binding SelectedEffect.HasTypeChoices,
                                             Converter={StaticResource ToneBoolToVisibility}}">

                        <TextBlock
                            Margin="0,0,14,8"
                            VerticalAlignment="Center"
                            Text="エフェクト種類"
                            Foreground="#A8BACB"
                            FontSize="12"/>

                        <ComboBox
                            Width="210"
                            MinHeight="34"
                            Margin="0,0,0,8"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding SelectedEffect.AvailablePresets}"
                            SelectedItem="{Binding SelectedEffect.SelectedPreset,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}"
                            DisplayMemberPath="ShortName"
                            Background="#E6E6E6"
                            Foreground="#172331"
                            FontSize="12"/>

                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="24,0,0,8">

                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedEffect.SlotName}"
                                            Value="DELAY">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock
                                Text="モード切替"
                                Foreground="#A8BACB"
                                FontSize="14"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0"/>

                            <RadioButton
                                Content="TIME"
                                GroupName="DelayTiming"
                                Foreground="#EDF2F7"
                                FontSize="16"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0"
                                IsChecked="{Binding IsTimeMode, Mode=TwoWay}"/>

                            <RadioButton
                                Content="TEMPO"
                                GroupName="DelayTiming"
                                Foreground="#EDF2F7"
                                FontSize="16"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsTempoMode, Mode=TwoWay}"/>
                        </StackPanel>
                    </WrapPanel>

                    <Border
                        x:Name="XyEditorDivider"
                        Grid.ColumnSpan="3"
                        Grid.Row="2"
                        Background="#2B3948"/>

                    <Grid
                        x:Name="XyArea"
                        Visibility="Collapsed"
                        Grid.Column="2"
                        Grid.Row="0"
                        Grid.RowSpan="6"
                        Margin="0"
                        SizeChanged="XyArea_SizeChanged">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <Canvas
                            x:Name="XyCanvas"
                            Height="486"
                            Grid.Column="0"
                            Margin="0,0,20,0"
                            Background="#10191F"
                            ClipToBounds="True"
                            Focusable="True"
                            Cursor="Cross"
                            AutomationProperties.Name="XY操作"
                            SizeChanged="XyCanvas_SizeChanged"
                            MouseLeftButtonDown="XyCanvas_MouseLeftButtonDown"
                            MouseMove="XyCanvas_MouseMove"
                            MouseLeftButtonUp="XyCanvas_MouseLeftButtonUp"
                            KeyDown="XyCanvas_KeyDown"/>

                        <ItemsControl
                            x:Name="XyKnobs"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            ItemTemplate="{StaticResource XyLinkedKnobTemplate}"/>

                        <ItemsControl
                            x:Name="XyIndependentKnobs"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            ItemTemplate="{StaticResource XyKnobTemplate}"/>
                    </Grid>

                    <Grid Grid.Row="3" Grid.ColumnSpan="3">
                        <Grid x:Name="NormalKnobArea">
                            <ItemsControl
                                Margin="0,24,0,12"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding SelectedEffect.Parameters}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Width="174"
                                            Margin="6,8,6,20"
                                            HorizontalAlignment="Center">

                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition
                                                                    Binding="{Binding Name}"
                                                                    Value="Time"/>

                                                                <Condition
                                                                    Binding="{Binding DataContext.IsTempoMode,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Value="True"/>
                                                            </MultiDataTrigger.Conditions>

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Collapsed"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition
                                                                    Binding="{Binding Name}"
                                                                    Value="BPM"/>

                                                                <Condition
                                                                    Binding="{Binding DataContext.IsTimeMode,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Value="True"/>
                                                            </MultiDataTrigger.Conditions>

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Collapsed"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition
                                                                    Binding="{Binding Name}"
                                                                    Value="Note"/>

                                                                <Condition
                                                                    Binding="{Binding DataContext.IsTimeMode,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Value="True"/>
                                                            </MultiDataTrigger.Conditions>

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Collapsed"/>
                                                        </MultiDataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <controls:Knob
                                                Width="150"
                                                Height="150"
                                                HorizontalAlignment="Center"
                                                Value="{Binding Value,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                Step="{Binding Step}"
                                                DisplayText="{Binding KnobText}"
                                                IsEnabled="{Binding IsEditable}"
                                                Minimum="{Binding Minimum}"
                                                Maximum="{Binding Maximum}"
                                                Accent="{Binding DataContext.SelectedEffect.ActiveAccentBrush,
                                                                 RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>

                                            <TextBlock
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Center"
                                                Text="{Binding Name}"
                                                Foreground="#EDF2F7"
                                                FontSize="17"
                                                FontWeight="SemiBold"/>

                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                Text="{Binding Unit}"
                                                Foreground="#8195A8"
                                                FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>

                    <TextBlock
                        x:Name="XyHelpText"
                        Grid.ColumnSpan="3"
                        Grid.Row="4"
                        Margin="0,6,0,0"
                        Text="ノブ：上下ドラッグ・マウスホイール・矢印キーで調整"
                        Foreground="#8195A8"
                        FontSize="12"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Grid.ColumnSpan="3"
                        Grid.Row="5"
                        Margin="0,8,0,0"
                        TextWrapping="Wrap"
                        Text="{Binding DelayTimingStatus}"
                        Foreground="{Binding DelayTimingStatusBrush}">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SelectedEffect.SlotName}"
                                        Value="DELAY">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>