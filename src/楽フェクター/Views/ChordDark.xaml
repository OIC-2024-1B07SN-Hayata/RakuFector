<!-- Dark theme: the same keys in Dark.xaml and Light.xaml (swapped by MainWindow's ダークモード switch). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#111214" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#1A1B1E" />
    <SolidColorBrush x:Key="SidebarActiveBackground" Color="#0F1013" />
    <SolidColorBrush x:Key="CardBackground" Color="#1B1C20" />
    <SolidColorBrush x:Key="CardBorder" Color="#2C2D31" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B0B3B8" />
    <SolidColorBrush x:Key="TextMuted" Color="#7D8086" />
    <SolidColorBrush x:Key="ControlBackground" Color="#0E0F11" />
    <SolidColorBrush x:Key="MeterOff" Color="#3A3B3F" />
    <SolidColorBrush x:Key="ControlBorder" Color="#2C2D31" />
    <SolidColorBrush x:Key="SidebarText" Color="#9AA0A6" />
    <SolidColorBrush x:Key="ControlHover" Color="#26272B" />
    <SolidColorBrush x:Key="TimelineGrid" Color="#2A2B2F" />
    <SolidColorBrush x:Key="MeterOn" Color="#43A047" />
    <SolidColorBrush x:Key="RecordBackground" Color="#CC2E00" />
    <SolidColorBrush x:Key="RecordHover" Color="#E03A08" />
    <SolidColorBrush x:Key="SwitchOn" Color="#4CAF2A" />
    <SolidColorBrush x:Key="Playhead" Color="#4FC3F7" />
</ResourceDictionary>
