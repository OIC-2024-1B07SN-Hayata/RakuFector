<!-- Dark theme: the same keys in Dark.xaml and Light.xaml (swapped by MainWindow's ダークモード switch). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#111214" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#1A1B1E" />
    <SolidColorBrush x:Key="SidebarActiveBackground" Color="#0F1013" />
    <SolidColorBrush x:Key="CardBackground" Color="#1B1C20" />
    <SolidColorBrush x:Key="CardBorder" Color="#2C2D31" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B0B3B8" />
    <SolidColorBrush x:Key="TextMuted" Color="#7D8086" />
    <SolidColorBrush x:Key="ControlBackground" Color="#0E0F11" />
    <SolidColorBrush x:Key="MeterOff" Color="#3A3B3F" />
    <SolidColorBrush x:Key="ControlBorder" Color="#2C2D31" />
    <SolidColorBrush x:Key="SidebarText" Color="#9AA0A6" />
    <SolidColorBrush x:Key="ControlHover" Color="#26272B" />
    <SolidColorBrush x:Key="TimelineGrid" Color="#2A2B2F" />
    <SolidColorBrush x:Key="MeterOn" Color="#43A047" />
    <SolidColorBrush x:Key="RecordBackground" Color="#CC2E00" />
    <SolidColorBrush x:Key="RecordHover" Color="#E03A08" />
    <SolidColorBrush x:Key="SwitchOn" Color="#4CAF2A" />
    <SolidColorBrush x:Key="Playhead" Color="#4FC3F7" />
    <!-- Key badge: a deep tint of the playhead blue so it stands out from the grey cards. -->
    <SolidColorBrush x:Key="KeyBadgeBackground" Color="#123A4D" />
    <SolidColorBrush x:Key="KeyBadgeBorder" Color="#2E7FA6" />
    <SolidColorBrush x:Key="KeyBadgeLabel" Color="#A6DDF5" />
    <!-- Scale fretboard -->
    <SolidColorBrush x:Key="FretBoard" Color="#24201C" />
    <SolidColorBrush x:Key="FretLine" Color="#5A5650" />
    <SolidColorBrush x:Key="FretScaleNote" Color="#2B7BB0" />
    <SolidColorBrush x:Key="FretScaleRoot" Color="#F08A24" />
    <SolidColorBrush x:Key="FretOutsideTone" Color="#FF6F91" />
    <SolidColorBrush x:Key="FretChip" Color="#1B3248" />
    <SolidColorBrush x:Key="FretScaleNoteFill" Color="#1A2230" />
    <SolidColorBrush x:Key="FretScaleNoteRing" Color="#9DB0C6" />
    <SolidColorBrush x:Key="NowPlayingBackground" Color="#1C2E1F" />
    <SolidColorBrush x:Key="NowPlayingBorder" Color="#3F6B3A" />
    <SolidColorBrush x:Key="NowPlayingDot" Color="#7BD86A" />
</ResourceDictionary>
