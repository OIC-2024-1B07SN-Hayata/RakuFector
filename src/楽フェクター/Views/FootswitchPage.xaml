<UserControl x:Class="FXForge.Views.FootswitchPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="#E8F7F1" Background="#0B1210">
 <UserControl.Resources>
  <Style x:Key="FootButton" TargetType="Button">
   <Setter Property="Foreground" Value="#D7FAE8"/>
   <Setter Property="Background" Value="#173A30"/>
   <Setter Property="BorderBrush" Value="#2C8B6C"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#236249"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CircleSwitch" TargetType="Button">
   <Setter Property="Width" Value="62"/><Setter Property="Height" Value="62"/>
   <Setter Property="Foreground" Value="#426E5C"/><Setter Property="Background" Value="#091310"/>
   <Setter Property="BorderBrush" Value="#245A49"/><Setter Property="BorderThickness" Value="3"/>
   <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="20"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Ring" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="40">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <DataTrigger Binding="{Binding IsLit}" Value="True">
      <Setter Property="Background" Value="#0B2119"/><Setter Property="BorderBrush" Value="#27D69B"/><Setter Property="Foreground" Value="#27D69B"/>
     </DataTrigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderThickness" Value="5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="118"/></Grid.RowDefinitions>
  <Border BorderBrush="#293E36" BorderThickness="0,0,0,1">
   <Grid Margin="25,12,25,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="FOOT SWITCH" FontSize="28" FontWeight="Bold" Foreground="White"/>
     <TextBlock Text="スイッチ割り当てと動作テスト（F1～F10：SW-1～SW-10）" Foreground="#7A9289" FontSize="12" Margin="1,7,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="PHYSICAL SWITCHES" FontSize="12" FontWeight="SemiBold" Foreground="#6C9786"/>
     <ComboBox x:Name="PhysicalCountSelector" Width="112" Height="31" HorizontalAlignment="Left" Margin="0,7,0,0" ItemsSource="{Binding PhysicalCounts}" SelectedItem="{Binding PhysicalCount,Mode=TwoWay}"/>
    </StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="23,19,18,12">
    <TextBlock Text="SWITCH ASSIGNMENTS" FontSize="12" FontWeight="SemiBold" Foreground="#4C9077" Margin="4,0,0,15"/>
    <ItemsControl ItemsSource="{Binding Switches}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Width="380" Height="195" Margin="3,0,13,16" Background="#14201C" BorderBrush="#294039" BorderThickness="1" CornerRadius="12" Padding="17">
       <Grid><Grid.RowDefinitions><RowDefinition Height="73"/><RowDefinition Height="21"/><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
         <Button Content="{Binding Number}" Style="{StaticResource CircleSwitch}" Tag="{Binding}" Click="Switch_Click" ToolTip="クリックしてスイッチ動作をテスト"/>
         <StackPanel Margin="18,8,0,0">
          <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="Bold" Foreground="#E7F8F0"/>
          <TextBlock Text="{Binding KeyLabel,StringFormat='KEY {0}'}" Margin="0,5,0,0" FontSize="12" Foreground="#688C7D" FontFamily="Consolas"/>
         </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="ASSIGN" Foreground="#7EA898" FontWeight="SemiBold" FontSize="11"/>
        <ComboBox Grid.Row="2" Height="31" ItemsSource="{Binding DataContext.Assignments,RelativeSource={RelativeSource AncestorType=UserControl}}"
         SelectedItem="{Binding Assignment,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="#DAEFE5" Foreground="#152B21"/>
        <TextBlock Grid.Row="3" Text="{Binding Status}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" Foreground="#27D69B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="#0C1914" BorderBrush="#293E36" BorderThickness="0,1,0,0">
   <StackPanel Margin="23,12,23,9">
    <StackPanel Orientation="Horizontal">
     <Button Content="＋ ADD SWITCH" Style="{StaticResource FootButton}" Width="144" Click="Add_Click" IsEnabled="{Binding CanAdd}" Margin="0,0,9,0"/>
     <Button Content="－ REMOVE" Style="{StaticResource FootButton}" Width="124" Click="Remove_Click" IsEnabled="{Binding CanRemove}" Margin="0,0,15,0"/>
     <Button Content="SAVE" Style="{StaticResource FootButton}" Width="92" Click="Save_Click" Margin="0,0,9,0"/>
     <Button Content="LOAD" Style="{StaticResource FootButton}" Width="92" Click="Load_Click" Margin="0,0,9,0"/>
     <Button Content="?" Style="{StaticResource FootButton}" Width="40" Click="Help_Click"/>
    </StackPanel>
    <TextBlock Text="{Binding StatusText}" Foreground="#27D69B" FontSize="12" FontFamily="Consolas" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="対応：歪みA/B・AMPのON/OFF、5音色の切替、チューナー表示。Delay/Reverb/Chorusは未実装。" Foreground="#7C998D" FontSize="11" Margin="0,5,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
