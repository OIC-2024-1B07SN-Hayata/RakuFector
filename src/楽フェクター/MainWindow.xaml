<Window x:Class="FXForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FXForge.Controls"
 Title="楽フェクター" Width="1600" Height="960" MinWidth="1280" MinHeight="740" Background="#0C0F12" Foreground="#ECF0F4" WindowStartupLocation="CenterScreen">
 <Grid x:Name="ShellRoot"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Border x:Name="ShellHeader" Background="#0F1317" BorderBrush="#28313A" BorderThickness="0,0,0,1"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Fill="#FF5B53" Width="11" Height="11" Margin="0,0,10,0"/><Ellipse Fill="#E9B323" Width="11" Height="11" Margin="0,0,10,0"/><Ellipse Fill="#39B34B" Width="11" Height="11" Margin="0,0,18,0"/><TextBlock Text="楽フェクター" Foreground="#20D7B1" FontSize="23" FontWeight="SemiBold"/></StackPanel>
   <TextBlock x:Name="PageTitleText" Grid.Column="2" Text="TONE STUDIO" Foreground="#8393A1" VerticalAlignment="Center" FontWeight="SemiBold"/>
   <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="保存" IsEnabled="False" Margin="0,0,10,0"/><ComboBox Width="210" IsEnabled="False"><ComboBoxItem IsSelected="True" Content="プリセットを選択"/></ComboBox><Button x:Name="OutputTestButton" Content="出力テスト" Click="OutputTest_Click" Margin="10,0,0,0" ToolTip="小さい確認音を3秒間出力します"/><Button Content="⚙" Click="AudioSettings_Click" Margin="10,0,0,0" Padding="12,10" ToolTip="共通音声入出力の設定"/><Button Content="?" Click="Help_Click" Margin="8,0,0,0" Padding="12,10"/></StackPanel>
  </Grid></Border>
  <Grid x:Name="ShellBody" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="ShellSidebar" Background="#17191C" BorderBrush="#2B3037" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Button x:Name="ToneNavButton" Style="{StaticResource NavButton}" Click="ToneNav_Click"><StackPanel><controls:NavGlyph Kind="Sliders" Width="32" Height="32" HorizontalAlignment="Center" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="音作り" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="TunerNavButton" Style="{StaticResource NavButton}" Click="TunerNav_Click"><StackPanel><controls:NavGlyph Kind="Gauge" Width="32" Height="32" HorizontalAlignment="Center" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="チューナー" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="ChordNavButton" Style="{StaticResource NavButton}" Click="ChordNav_Click"><StackPanel><controls:NavGlyph Kind="Grid" Width="32" Height="32" HorizontalAlignment="Center" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="コード検出" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="DrumNavButton" Style="{StaticResource NavButton}" Click="DrumNav_Click"><StackPanel><controls:NavGlyph Kind="List" Width="32" Height="32" HorizontalAlignment="Center" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="ドラム編集" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="FootswitchNavButton" Style="{StaticResource NavButton}" Click="FootswitchNav_Click"><StackPanel><controls:NavGlyph Kind="Footswitch" Width="32" Height="32" HorizontalAlignment="Center" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="フットスイッチ設定" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="18,16"><TextBlock Text="楽フェクター" Foreground="#53616E" FontSize="10"/></StackPanel>
   </Grid></Border>
   <ContentControl x:Name="MainContent" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
  <Border x:Name="ShellFooter" Grid.Row="2" Background="#0B1015" BorderBrush="#29323C" BorderThickness="0,1,0,0"><DockPanel Margin="20,0"><TextBlock x:Name="AudioStatusText" Text="共通音声: 未接続" Foreground="#8A9DAC" FontSize="11" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</Window>
